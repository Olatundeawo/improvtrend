// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



enum ReactionType {
  SPICY
  PLOT_TWIST
  FUNNY
  BEST_LINE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum Genre {
  COMEDY
  HORROR
  ROMANCE
  MYSTERY
  FANTASY
  SCI_FI
  DRAMA
  ADVENTURE
  THRILLER
  SLICE_OF_LIFE
}

enum UserLevel {
  NEWCOMER      
  STORYTELLER    
  SCRIBE         
  AUTHOR         
  GRAND_NARRATOR 
}

enum BadgeType {
  
  NEWBIE
  CONTRIBUTOR
  CREATOR
  TREND_STARTER
  PLOT_TWISTER     
  SCENE_SETTER     
  NARRATOR_KING    
  SPEED_WRITER     
  CHARACTER_ACTOR
}

enum NotificationType {
  BADGE_UNLOCKED
  LEVEL_UP
  NEW_COMMENT
  NEW_REACTION
  TURN_RELY
  STORY_TRENDING
  CLAIM_EXPIRY_WARNING 
  CLAIM_AUTO_RELEASED
}
enum ArcSize {
  SHORT
  MEDIUM
  EPIC
}

enum ArcStage {
  SETUP
  RISING
  CLIMAX
  RESOLUTION
}

enum StoryStatus {
  ACTIVE
  COMPLETED
}

enum XpReason {
  TURN_WRITTEN
  CLIMAX_BONUS
  VIRAL_TURN
  STORY_COMPLETION
}

model User {
  id            String      @id @default(uuid())
  username      String      @unique
  email         String      @unique
  passwordHash  String?
  createdAt     DateTime    @default(now())

  // Social login
  authProvider  AuthProvider @default(LOCAL)
  googleId      String?      @unique
  avatarUrl     String?

  // Profile
  bio               String?
  genrePreferences  Genre[]   @default([])

  // Gamification
  xp              Int         @default(0)
  level           UserLevel   @default(NEWCOMER)
  streak          Int         @default(0)
  lastTurnDate    DateTime?
  storyCount      Int         @default(0)

  // Relations
  xpTransactions    XpTransaction[]
  badges            UserBadgeRecord[] 
  stories           Story[]
  turns             Turn[]
  comments          Comment[]
  reactions         TurnReaction[]
  notifications     Notification[]
  claimedCharacters Character[]
  storyVotes        StoryVote[]
}

model UserBadgeRecord {
  id          String    @id @default(uuid())
  userId      String
  badge       BadgeType
  awardedAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, badge])
  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Story {
  id          String      @id @default(uuid())
  userId      String
  title       String
  content     String
  isLocked    Boolean     @default(false)
  createdAt   DateTime    @default(now())

  arcSize     ArcSize     @default(SHORT)
  maxTurns    Int         @default(6)
  turnCount   Int         @default(0)
  arcStage    ArcStage    @default(SETUP)
  status      StoryStatus @default(ACTIVE)

  user        User        @relation(fields: [userId], references: [id])
  turns       Turn[]
  characters  Character[]
  comments    Comment[]
  votes       StoryVote[]

  @@index([createdAt])
}

model StoryVote {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([storyId, userId])
  @@index([storyId])
}

model Character {
  id              Int      @id @default(autoincrement())
  name            String
  storyId         String
  claimedByUserId String?

  claimExpiresAt  DateTime?
  lastTurnAt      DateTime?
  warningSentAt   DateTime?

  turns     Turn[]
  story     Story   @relation(fields: [storyId], references: [id])
  claimedBy User?   @relation(fields: [claimedByUserId], references: [id])

  @@unique([name, storyId])
  @@index([claimExpiresAt])
}

model Turn {
  id            String        @id @default(uuid())
  storyId       String
  userId        String
  characterId   Int
  content       String
  createdAt     DateTime      @default(now())
  editedAt      DateTime? 

  story         Story         @relation(fields: [storyId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  character     Character     @relation(fields: [characterId], references: [id])
  reactions     TurnReaction[]

  @@index([storyId, createdAt])
}

model TurnReaction {
  id           String       @id @default(uuid())
  turnId       String
  userId       String
  type         ReactionType
  createdAt    DateTime     @default(now())

  turn         Turn         @relation(fields: [turnId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([turnId, userId]) 
  @@index([turnId])
  @@index([userId])
}

model Comment {
  id              String      @id @default(uuid())
  storyId         String
  userId          String
  content         String
  createdAt       DateTime    @default(now())

  story           Story       @relation(fields: [storyId], references: [id])
  user            User        @relation(fields: [userId], references: [id])

  @@index([storyId, createdAt])
}

model XpTransaction {
  id         String    @id @default(uuid())
  userId     String
  reason     XpReason
  points     Int
  multiplier Float     @default(1.0)
  finalXp    Int
  meta       Json?  
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
